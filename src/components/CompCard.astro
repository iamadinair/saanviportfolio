---
import { siteConfig } from '../data/site.config.js';
---
<section id="compcard-section" class="slide-panel slide-panel--compact">
  <div class="nursery-sky" aria-hidden="true">
    <div class="cloud cloud--3" style="left: 8%;"></div>
    <div class="cloud cloud--1" style="left: 62%;"></div>
    <div class="cloud cloud--4" style="left: 32%;"></div>
    <span class="star star--lg" style="top: 18%; left: 84%; animation-delay: -1.1s;">✦</span>
    <span class="star star--sm" style="top: 24%; left: 10%; animation-delay: -2.3s;">✦</span>
    <span class="star star--xl" style="top: 70%; left: 74%; animation-delay: -0.5s;">✦</span>
    <span class="star" style="top: 82%; left: 22%; animation-delay: -1.7s;">✦</span>
    <span class="star star--sm" style="top: 52%; left: 92%; animation-delay: -2.8s;">✦</span>
  </div>
  <div class="slide-exit-inner">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">For casting directors</p>
        <h2 id="compcard">Comp card</h2>
      </div>
      <div class="compcard-box">
        <p>One page, ready to download and pass along.</p>
        <a class="btn" href={siteConfig.compCardPdfPath} download>Download comp card</a>
      </div>
    </div>
  </div>
</section>
