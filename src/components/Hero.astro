---
import { siteConfig } from '../data/site.config.js';
---
<section class="hero slide-panel">
  <div class="nursery-sky" aria-hidden="true">
    <div class="cloud cloud--1" style="left: -10%;"></div>
    <div class="cloud cloud--2" style="left: 40%;"></div>
    <div class="cloud cloud--3" style="left: 70%;"></div>
    <span class="star star--sm" style="top: 16%; left: 14%;">✦</span>
    <span class="star" style="top: 26%; left: 84%; animation-delay: -1.2s;">✦</span>
    <span class="star star--lg" style="top: 68%; left: 22%; animation-delay: -2.1s;">✦</span>
    <span class="star star--sm" style="top: 80%; left: 74%; animation-delay: -0.6s;">✦</span>
    <span class="star" style="top: 46%; left: 6%; animation-delay: -1.7s;">✦</span>
  </div>
  <div class="slide-exit-inner">
    <div class="container">
      <p class="eyebrow">Portfolio</p>
      <h1>Hi, I'm {siteConfig.profile.name}</h1>
      <p class="hero-sub">As you scroll, meet a little face full of personality.</p>
    </div>
  </div>
</section>
