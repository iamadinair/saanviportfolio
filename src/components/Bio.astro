---
import { siteConfig } from '../data/site.config.js';
const { profile } = siteConfig;
const temperamentLine = profile.temperamentNotes
  .slice(0, 2)
  .map((n) => n.toLowerCase())
  .join(' and ');
---
<section id="about" class="slide-panel">
  <div class="nursery-sky" aria-hidden="true">
    <div class="cloud cloud--2" style="left: 5%;"></div>
    <div class="cloud cloud--3" style="left: 55%;"></div>
    <span class="star" style="top: 20%; left: 78%; animation-delay: -0.9s;">✦</span>
    <span class="star star--lg" style="top: 72%; left: 10%; animation-delay: -1.8s;">✦</span>
    <span class="star star--sm" style="top: 84%; left: 66%; animation-delay: -2.4s;">✦</span>
    <span class="star star--sm" style="top: 12%; left: 40%; animation-delay: -0.4s;">✦</span>
  </div>
  <div class="slide-exit-inner">
    <div class="container about-wrap">
      <p class="eyebrow">About</p>
      <p class="bio">
        I'm <span>{profile.name}</span>, <span>{profile.ageRange}</span> old and based in
        <span>{profile.location}</span>. I stand at <span>{profile.stats.height}</span> tall,
        weigh <span>{profile.stats.weight}</span>, and wear size <span>{profile.stats.clothingSize}</span> clothing, with
        <span> {profile.stats.eyeColour.toLowerCase()}</span> eyes and <span>{profile.stats.hairColour.toLowerCase()}</span> hair. I'm
        <span>{temperamentLine}</span>. I'm always happy to hear from
        agencies and photographers looking to collaborate.
      </p>
    </div>
  </div>
</section>
