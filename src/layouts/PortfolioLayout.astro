---
import '../styles/global.css';
import { siteConfig } from '../data/site.config.js';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Saanvi — Kids Modelling Portfolio',
  description = `${siteConfig.profile.ageRange} · ${siteConfig.profile.location}`,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Open Graph / social preview -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="/og-image-v1.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="/og-image-v1.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
  <slot />

  <!-- Web3Forms hCaptcha widget (used by ContactForm.astro) -->
  <script src="https://web3forms.com/client/script.js" async defer></script>

  <script>
    // Scroll-reveal: fade/slide sections and photo blocks in as they enter view.
    document.addEventListener('DOMContentLoaded', () => {
      const revealEls = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }
    });

    // Scroll-linked section transitions: as each full-viewport section is
    // scrolled past, its content gracefully fades and lifts away while the
    // next section's content simultaneously settles into place — driven
    // entirely by scroll position (the same technique already used for the
    // carousel's horizontal movement), never by a fixed-speed canned
    // animation. This never calls preventDefault or scrollTo — it only
    // reads scroll position and applies a transform in response — so it
    // can't get "stuck" and works identically with mouse, trackpad, or touch.
    document.addEventListener('DOMContentLoaded', () => {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) return;

      const lift = 56;
      const clamp = (v, min, max) => Math.min(Math.max(v, min), max);
      const navEl = document.querySelector('header.nav');
      const navOffset = () => (navEl ? navEl.offsetHeight : 0);

      // Easing applied to the raw (linear) progress before it drives
      // opacity/transform. A pure power curve keeps the endpoints fixed at
      // 0 and 1 — so the gap-free handoff between adjacent sections is
      // unaffected — while reshaping the middle: entrance reaches full
      // opacity quickly and then holds, exit holds at full opacity and
      // only drops quickly right at the end.
      const EASE_POWER = 2.5;
      const easeIn = (v) => Math.pow(v, 1 / EASE_POWER);
      const easeOut = (w) => Math.pow(w, EASE_POWER);

      // Each panel needs TWO separate budgets, not one shared value:
      // - exitBudget: half of the panel's OWN height, governing how it
      //   fades away as it's scrolled past.
      // - entranceBudget: half of the PRECEDING panel's height, governing
      //   how this panel fades in. Using the panel's own height for this
      //   would only line up with the preceding section's exit when both
      //   are the same height — now that text sections (compact) and
      //   photo/carousel sections (full height) differ, entrance has to
      //   be pinned to whatever the previous section actually used for
      //   its exit, or the two don't meet at the same scroll position and
      //   a visible gap reopens where both read near-zero opacity.
      function findPrecedingSlideHeight(startEl) {
        let node = startEl;
        while (node.parentElement && node.parentElement !== document.body) {
          node = node.parentElement;
        }
        let sib = node.previousElementSibling;
        while (sib) {
          if (sib.classList.contains('slide-panel')) {
            return sib.getBoundingClientRect().height;
          }
          sib = sib.previousElementSibling;
        }
        return window.innerHeight;
      }

      const panels = Array.from(document.querySelectorAll('.slide-panel')).map((panel) => ({
        panel,
        inner: panel.querySelector(':scope > .slide-exit-inner'),
        entranceBudget: 0,
        exitBudget: 0,
      })).filter((p) => p.inner);

      // Entrance-only elements (footer, the carousel) have no exit of
      // their own — they borrow the preceding .slide-panel's height for
      // their entrance, same idea as above.
      const fadeIns = Array.from(document.querySelectorAll('.slide-fade-in')).map((el) => ({
        el,
        entranceBudget: 0,
      }));

      function measureBudgets() {
        panels.forEach((p) => {
          p.exitBudget = p.panel.getBoundingClientRect().height / 2;
          p.entranceBudget = findPrecedingSlideHeight(p.panel) / 2;
        });
        fadeIns.forEach((f) => {
          f.entranceBudget = findPrecedingSlideHeight(f.el) / 2;
        });
      }

      function updatePanel({ panel, inner, entranceBudget, exitBudget }) {
        const top = panel.getBoundingClientRect().top - navOffset();
        let opacity;
        let translateY;
        if (top >= 0) {
          const v = easeIn(clamp(1 - top / entranceBudget, 0, 1));
          opacity = v;
          translateY = (1 - v) * lift;
        } else {
          const w = easeOut(clamp(-top / exitBudget, 0, 1));
          opacity = 1 - w;
          translateY = -w * lift;
        }
        inner.style.opacity = String(opacity);
        inner.style.transform = `translateY(${translateY}px)`;
      }

      function updateFadeIn({ el, entranceBudget }) {
        const top = el.getBoundingClientRect().top - navOffset();
        const v = easeIn(clamp(1 - top / entranceBudget, 0, 1));
        el.style.opacity = String(v);
        el.style.transform = `translateY(${(1 - v) * lift}px)`;
      }

      let ticking = false;
      function update() {
        panels.forEach(updatePanel);
        fadeIns.forEach(updateFadeIn);
        ticking = false;
      }
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }

      measureBudgets();
      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => {
        measureBudgets();
        update();
      });
    });
  </script>
</body>
</html>
